# Copier vers .env sur le serveur, puis : php artisan key:generate
# PHP requis : 8.3.31 minimum (Symfony 7.4 via composer.lock)

APP_NAME="Built in Benin"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mon-blog-production.up.railway.app

BLOG_TAGLINE="by Starboy"
BLOG_CONTACT_EMAIL=
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
BLOG_OG_IMAGE=

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
# En local : renseigne DB_* ci-dessous.
# Sur Railway : ajoute un service MySQL et lie-le au service web.
# Laisse DB_HOST vide (ou 127.0.0.1) — l'app utilisera MYSQLHOST automatiquement.
DB_HOST=
DB_PORT=3306
DB_DATABASE=railway
DB_USERNAME=
DB_PASSWORD=

# Premier déploiement uniquement (puis repasse à false) :
# RUN_DB_SEED=true

SESSION_DRIVER=database
SESSION_ENCRYPT=true

FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contact@ton-domaine.com"
MAIL_FROM_NAME="${APP_NAME}"

# false = commentaires visibles tout de suite | true = modération admin
BLOG_COMMENTS_REQUIRE_MODERATION=false
BLOG_COMMENTS_NOTIFY_AUTHOR=true

VITE_APP_NAME="${APP_NAME}"

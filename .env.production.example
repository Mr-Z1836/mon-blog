# Copier vers .env sur le serveur, puis : php artisan key:generate

APP_NAME="Harry's Blog"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ton-domaine.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mon_blog
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_ENCRYPT=true

FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contact@ton-domaine.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
